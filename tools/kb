#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_TEMPLATE_FILE="${ROOT_DIR}/mkdocs.kb.template.yml"
GENERATED_PARENT="${ROOT_DIR}/.local/kb-generated"
GENERATED_ROOT=""
GENERATED_CONFIG_FILE="${GENERATED_ROOT}/mkdocs.kb.generated.yml"
UV_CACHE_DIR="${UV_CACHE_DIR:-${ROOT_DIR}/.uv-cache}"

usage() {
    cat <<'EOF'
Usage: tools/kb <command>

Commands:
  check        Validate required knowledge-base files and directories
  build        Build the MkDocs site in strict mode
  serve        Serve the MkDocs site locally
  compile      Alias for build
EOF
}

require_file() {
    local path="$1"
    if [ ! -f "$path" ]; then
        echo "missing file: $path" >&2
        exit 1
    fi
}

require_dir() {
    local path="$1"
    if [ ! -d "$path" ]; then
        echo "missing directory: $path" >&2
        exit 1
    fi
}

run_mkdocs() {
    if command -v uv >/dev/null 2>&1; then
        mkdir -p "$UV_CACHE_DIR"
        UV_CACHE_DIR="$UV_CACHE_DIR" uv run --with-requirements "${ROOT_DIR}/requirements-kb.txt" mkdocs "$@" -f "$GENERATED_CONFIG_FILE"
        return
    fi

    python3 -m mkdocs "$@" -f "$GENERATED_CONFIG_FILE"
}

generate_inputs() {
    if [ -z "$GENERATED_ROOT" ]; then
        echo "generated root has not been initialized" >&2
        exit 1
    fi

    if command -v uv >/dev/null 2>&1; then
        mkdir -p "$UV_CACHE_DIR"
        UV_CACHE_DIR="$UV_CACHE_DIR" uv run python "${ROOT_DIR}/tools/kb_generate.py" --generated-root "$GENERATED_ROOT"
        return
    fi

    python3 "${ROOT_DIR}/tools/kb_generate.py" --generated-root "$GENERATED_ROOT"
}

check_structure() {
    require_file "${ROOT_DIR}/docs/kb/README.md"
    require_file "${ROOT_DIR}/docs/kb/schema.md"
    require_file "${ROOT_DIR}/docs/kb/ingest.md"
    require_file "${ROOT_DIR}/docs/kb/wiki/index.md"
    require_file "${ROOT_DIR}/docs/kb/wiki/log.md"
    require_dir "${ROOT_DIR}/docs/kb/ja"
    require_dir "${ROOT_DIR}/docs/kb/ja/sources"
    require_dir "${ROOT_DIR}/docs/kb/ja/wiki"
    require_dir "${ROOT_DIR}/docs/kb/sources"
    require_dir "${ROOT_DIR}/docs/kb/wiki/projects"
    require_dir "${ROOT_DIR}/docs/kb/wiki/topics"
    require_dir "${ROOT_DIR}/docs/kb/wiki/tools"
    require_dir "${ROOT_DIR}/docs/kb/wiki/patterns"
    require_file "$CONFIG_TEMPLATE_FILE"
    echo "knowledge base structure: OK"
}

prepare_generated_root() {
    local command_name="$1"

    mkdir -p "$GENERATED_PARENT"
    GENERATED_ROOT="$(mktemp -d "${GENERATED_PARENT}/${command_name}.XXXXXXXXXX")"
    GENERATED_CONFIG_FILE="${GENERATED_ROOT}/mkdocs.kb.generated.yml"
}

cleanup_generated_root() {
    if [ -z "$GENERATED_ROOT" ] || [ ! -e "$GENERATED_ROOT" ]; then
        return
    fi

    if ! rm -rf "$GENERATED_ROOT"; then
        echo "warning: failed to clean generated KB workspace: $GENERATED_ROOT" >&2
        echo "warning: leaving local artifact for inspection" >&2
    fi
}

command="${1:-}"

case "$command" in
    check)
        prepare_generated_root "$command"
        check_structure
        generate_inputs
        cleanup_generated_root
        ;;
    build|compile)
        prepare_generated_root "$command"
        check_structure
        generate_inputs
        run_mkdocs build --strict
        cleanup_generated_root
        ;;
    serve)
        prepare_generated_root "$command"
        trap cleanup_generated_root EXIT
        check_structure
        generate_inputs
        run_mkdocs serve
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        echo "unknown command: $command" >&2
        usage
        exit 1
        ;;
esac
